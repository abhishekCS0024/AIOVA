# Copy to .env and fill in.
ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=rca
POSTGRES_PASSWORD=rca
POSTGRES_DB=rca
DATABASE_URL=postgresql+psycopg://rca:rca@localhost:5432/rca

# Groq LLM (docs §7.3: model is configurable because Groq retires models)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_VALIDATION_RETRIES=1
LLM_MAX_RETRIES=8

MAX_UPLOAD_MB=20
CORS_ORIGINS=["http://localhost:5173"]
